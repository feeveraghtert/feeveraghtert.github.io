<link rel="stylesheet" href="assets/css/Hero-Carousel-images.css">
<link rel="stylesheet" href="assets/css/OwlCarousel2-Full-Screen.css">
<link rel="stylesheet" href="assets/css/Simple-Slider-swiper-bundle.min.css">
<link rel="stylesheet" href="assets/css/Simple-Slider.css">
<link rel="stylesheet" href="assets/css/fee-template.css">

</head>
<body>
<header>
  <nav class="navbar navbar-expand-md bg-body fee-navbar" style="text-align:right;">
    <div class="container-fluid">
      <button class="navbar-toggler" data-bs-target="#navcol-1" data-bs-toggle="collapse">
        <span class="visually-hidden">Toggle navigation</span>
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navcol-1">
        <a class="navbar-brand logo" href="index.html"><span>Fee Veraghtert</span></a>
        <ul class="navbar-nav ms-auto ps-5">
          <li class="nav-item me-3"><a class="nav-link" href="paintings.html"><small>Paintings</small></a></li>
          <li class="nav-item me-3"><a class="nav-link" href="works on paper.html"><small>Works on paper</small></a></li>
